m4_dnl Definitions shared by Dockerfile-ubuntu.m4 and Dockerfile-rockylinux.m4.
m4_dnl Run m4 with the -P command-line option, so built-in macros are prefixed by "m4_".
m4_dnl The caller defines these macros on the command line:
m4_dnl   JDKVER: the JDK version, such as 21
m4_dnl   PLUS: 1 for a "-plus" image (which contains more tools), 0 otherwise
m4_changequote([[,]])m4_dnl
m4_dnl Disable comments, so that macros are expanded within "#" comments.
m4_changecom()m4_dnl
m4_dnl Increment this variable not when a new LTS JDK is released, but only once every OS packages it.
m4_define([[latest_lts_release]], [[25]])m4_dnl
m4_dnl jdk_packaged_by_every_os expands to 1 if *every* OS in DOCKERFILE_OSES provides JDKVER as an OS package,
m4_dnl and to 0 otherwise.  When it is 0, the JDK is downloaded from jdk_download_url.
m4_dnl Rocky Linux's own repositories package only LTS JDKs.  The EPEL
m4_dnl repository provides java-NN-openjdk for the newest JDK NN.  That package may be an
m4_dnl early-access build, and downloading ensures consistency across OSes in CI.
m4_define([[jdk_packaged_by_every_os]], [[m4_eval(JDKVER <= latest_lts_release)]])m4_dnl
m4_define([[jdk_download_url]], [[https://download.java.net/java/GA/jdk27/55ce5470a6294008af0057ff4626d0e5/35/GPL/openjdk-27_linux-x64_bin.tar.gz]])m4_dnl
m4_dnl if_plus(TEXT) expands to TEXT for a "-plus" image, and to nothing otherwise.
m4_define([[if_plus]], [[m4_ifelse(PLUS, 1, [[$1]])]])m4_dnl
m4_dnl The comment at the top of each generated Dockerfile.
m4_dnl The "syntax" parser directive must be the first line.  It selects a
m4_dnl BuildKit Dockerfile frontend that supports here-documents ("<<EOF"), which
m4_dnl the legacy (non-BuildKit) builder does not support.
m4_define([[dockerfile_header]], [[# syntax=docker/dockerfile:1
# DO NOT EDIT this file.  Edit $1 instead.

m4_ifelse(PLUS, 1, [[# Create a Docker image that is ready to run the full Daikon tests,
# including building the manual and Javadoc.
# But it's used primarily for running miscellaneous tests such as the manual
# and Javadoc.]], [[# Create a Docker image that is ready to run the Daikon tests.]])]])m4_dnl
m4_dnl java_lib_gradle_plugins expands to the "plugins" block of ../java/lib/build.gradle,
m4_dnl or exits with an error if that file has no such block.
m4_define([[java_lib_gradle_plugins]], [[m4_esyscmd([[sed -n '/^plugins {/,/^}/p' ../java/lib/build.gradle | grep .]])m4_ifelse(m4_sysval, 0, , [[m4_errprint([[error: no "plugins" block in ../java/lib/build.gradle
]])m4_m4exit(1)]])]])m4_dnl
m4_dnl gradle_dependency_cache expands to Dockerfile commands that download the Gradle
m4_dnl plugins that ../java/lib/build.gradle uses into a read-only dependency cache.
m4_dnl Gradle must already be installed.  It expands to nothing for a JDK older than 17,
m4_dnl on which Gradle 9 does not run.
m4_define([[gradle_dependency_cache]], [[m4_ifelse(m4_eval(JDKVER >= 17), 1, [[# Download the Gradle plugins that java/lib/build.gradle uses, so that a CI job
# that builds daikon-plumelib.jar does not download them from Maven Central,
# which rejects requests with status 429 (Too Many Requests) when many CI
# jobs start at once.  The cache is outside /root/.gradle because GitHub
# Actions sets HOME to /github/home in a container job.
# GRADLE_RO_DEP_CACHE names a read-only cache, in which Gradle never writes
# and therefore needs no lock files.  scripts/test-misc.sh runs Gradle offline
# when GRADLE_RO_DEP_CACHE is set, so when the plugins in java/lib/build.gradle
# change, the misc CI jobs fail until the images are rebuilt.
COPY <<'EOF' /tmp/gradle-plugins/build.gradle
java_lib_gradle_plugins[[]]m4_dnl
EOF
RUN touch /tmp/gradle-plugins/settings.gradle \
&& GRADLE_USER_HOME=/tmp/gradle-user-home gradle -p /tmp/gradle-plugins --no-daemon -q buildEnvironment > /dev/null \
&& mkdir -p /opt/gradle-ro-dep-cache \
&& cp -r /tmp/gradle-user-home/caches/modules-2 /opt/gradle-ro-dep-cache/ \
&& find /opt/gradle-ro-dep-cache \( -name '*.lock' -o -name gc.properties \) -delete \
&& chmod -R og+rX /opt/gradle-ro-dep-cache \
&& rm -rf /tmp/gradle-plugins /tmp/gradle-user-home
ENV GRADLE_RO_DEP_CACHE=/opt/gradle-ro-dep-cache]])]])m4_dnl
