#!/bin/sh
#
#   Executes the command specified in the file named by the first argument
#   Provides a simple (very non-secure) way to execute commands from
#   a browser.  Specifically used to handle files of type applications/emacs
#   generated by log2html.php to bring up a buffer in emacs.

if [ $# -ne 1 ]; then
  echo "usage: $(basename "$0") FILE" >&2
  exit 2
fi

cmd=$(cat "$1") || exit 1
eval "$cmd"
