decl-version 2.0

// Declarations for a class whose fields are used in splitting conditions together with names
// that do not start with a variable name, such as java.lang.Math.abs.

var-comparability none

ppt misc.QualifiedNames.m(misc.QualifiedNames):::ENTER
  ppt-type enter
  variable this
    var-kind variable
    dec-type misc.QualifiedNames
    rep-type hashcode
    flags is_param
    comparability 22
  variable this.x
    var-kind field x
    enclosing-var this
    dec-type double
    rep-type double
    comparability 22
  variable p
    var-kind variable
    dec-type misc.QualifiedNames
    rep-type hashcode
    flags is_param
    comparability 22
  variable p.count
    var-kind field count
    enclosing-var p
    dec-type int
    rep-type int
    comparability 22

ppt misc.QualifiedNames.m(misc.QualifiedNames):::EXIT10
  ppt-type subexit
  variable this
    var-kind variable
    dec-type misc.QualifiedNames
    rep-type hashcode
    flags is_param
    comparability 22
  variable this.x
    var-kind field x
    enclosing-var this
    dec-type double
    rep-type double
    comparability 22
  variable p
    var-kind variable
    dec-type misc.QualifiedNames
    rep-type hashcode
    flags is_param
    comparability 22
  variable p.count
    var-kind field count
    enclosing-var p
    dec-type int
    rep-type int
    comparability 22
