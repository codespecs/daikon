import daikon.*;
import daikon.inv.*;
import daikon.split.*;

public final class misc_QuantCalls_m_56 extends Splitter {

  public String condition() {
    return "this.sign != null && (daikon.Quant.getElement_String(this.s, 0)) == null";
  }

  VarInfo this_s_array_varinfo; // this.s[..]
  VarInfo this_sign_varinfo; // this.sign

  static DummyInvariant dummyInvFactory;
  DummyInvariant dummyInv;

  public misc_QuantCalls_m_56() { }
  public misc_QuantCalls_m_56(Ppt ppt) {
    this_s_array_varinfo = ppt.find_var_by_name("this.s[..]");
    this_sign_varinfo = ppt.find_var_by_name("this.sign");
  }

  public Splitter instantiateSplitter(Ppt ppt) {
    return new misc_QuantCalls_m_56(ppt);
  }

  public boolean valid() {
    return (this_s_array_varinfo != null) && (this_sign_varinfo != null);
  }

  public boolean test(ValueTuple vt) {
    /* writeTestBody: 2 declarations */
    java.lang.String[] this_s_array = this_s_array_varinfo.getStringArrayValue(vt);
    String this_sign = this_sign_varinfo.getStringValue(vt);
    return(this_sign!=null&&(getElement_String(this_s_array,0))==null);
  }

  public String repr() {
    return "misc_QuantCalls_m_56: "
      + "this_s_array_varinfo = " + this_s_array_varinfo.repr() + " "
      + "this_sign_varinfo = " + this_sign_varinfo.repr() + " "
      ;
  }

  public void makeDummyInvariantFactory(DummyInvariant inv) {
    dummyInvFactory = inv;
  }

  public void instantiateDummy(PptTopLevel ppt) {
    dummyInv = null;
    VarInfo this_s_array_vi = ppt.find_var_by_name("this.s[..]");
    VarInfo this_sign_vi = ppt.find_var_by_name("this.sign");
    if (this_s_array_vi != null && this_sign_vi != null) {
      dummyInv = dummyInvFactory.instantiate(ppt, new VarInfo[] {this_s_array_vi, this_sign_vi});
    }
  }

  public DummyInvariant getDummyInvariant() {
    return dummyInv;
  }

  public int[] getIntArray(long[] longArray) {
    int[] intArray = new int[longArray.length];
    for (int i = 0; i < intArray.length; i++) {
      intArray[i] = (int) longArray[i];
    }
    return intArray;
  }

}
