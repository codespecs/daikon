import daikon.*;
import daikon.inv.*;
import daikon.split.*;

public final class misc_QuantCalls_m_53 extends Splitter {

  public String condition() {
    return "daikon.Quant.getElement_Object(this.s, i) != null";
  }

  VarInfo i_varinfo; // i
  VarInfo this_s_array_varinfo; // this.s[]

  static DummyInvariant dummyInvFactory;
  DummyInvariant dummyInv;

  public misc_QuantCalls_m_53() { }
  public misc_QuantCalls_m_53(Ppt ppt) {
    i_varinfo = ppt.find_var_by_name("i");
    this_s_array_varinfo = ppt.find_var_by_name("this.s[]");
  }

  public Splitter instantiateSplitter(Ppt ppt) {
    return new misc_QuantCalls_m_53(ppt);
  }

  public boolean valid() {
    return (i_varinfo != null) && (this_s_array_varinfo != null);
  }

  public boolean test(ValueTuple vt) {
    /* writeTestBody: 2 declarations */
    long i = i_varinfo.getIntValue(vt);
    java.lang.String[] this_s_array = this_s_array_varinfo.getStringArrayValue(vt);
    return(getElement_Object(this_s_array,i)!=null);
  }

  public String repr() {
    return "misc_QuantCalls_m_53: "
      + "i_varinfo = " + i_varinfo.repr() + " "
      + "this_s_array_varinfo = " + this_s_array_varinfo.repr() + " "
      ;
  }

  public void makeDummyInvariantFactory(DummyInvariant inv) {
    dummyInvFactory = inv;
  }

  public void instantiateDummy(PptTopLevel ppt) {
    dummyInv = null;
    VarInfo i_vi = ppt.find_var_by_name("i");
    VarInfo this_s_array_vi = ppt.find_var_by_name("this.s[]");
    if (i_vi != null && this_s_array_vi != null) {
      dummyInv = dummyInvFactory.instantiate(ppt, new VarInfo[] {i_vi, this_s_array_vi});
    }
  }

  public DummyInvariant getDummyInvariant() {
    return dummyInv;
  }

  public int[] getIntArray(long[] longArray) {
    int[] intArray = new int[longArray.length];
    for (int i = 0; i < intArray.length; i++) {
      intArray[i] = (int) longArray[i];
    }
    return intArray;
  }

}
