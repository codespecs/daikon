import daikon.*;
import daikon.inv.*;
import daikon.split.*;

public final class misc_QuantCalls_m_48 extends Splitter {

  public String condition() {
    return "daikon.Quant.getElement_boolean(this.flags, i)";
  }

  VarInfo i_varinfo; // i
  VarInfo this_flags_array_varinfo; // this.flags[]

  static DummyInvariant dummyInvFactory;
  DummyInvariant dummyInv;

  public misc_QuantCalls_m_48() { }
  public misc_QuantCalls_m_48(Ppt ppt) {
    i_varinfo = ppt.find_var_by_name("i");
    this_flags_array_varinfo = ppt.find_var_by_name("this.flags[]");
  }

  public Splitter instantiateSplitter(Ppt ppt) {
    return new misc_QuantCalls_m_48(ppt);
  }

  public boolean valid() {
    return (i_varinfo != null) && (this_flags_array_varinfo != null);
  }

  public boolean test(ValueTuple vt) {
    /* writeTestBody: 2 declarations */
    long i = i_varinfo.getIntValue(vt);
    long[] this_flags_array = this_flags_array_varinfo.getIntArrayValue(vt);
    return((this_flags_array==null?false:this_flags_array[(int)(i)]>0));
  }

  public String repr() {
    return "misc_QuantCalls_m_48: "
      + "i_varinfo = " + i_varinfo.repr() + " "
      + "this_flags_array_varinfo = " + this_flags_array_varinfo.repr() + " "
      ;
  }

  public void makeDummyInvariantFactory(DummyInvariant inv) {
    dummyInvFactory = inv;
  }

  public void instantiateDummy(PptTopLevel ppt) {
    dummyInv = null;
    VarInfo i_vi = ppt.find_var_by_name("i");
    VarInfo this_flags_array_vi = ppt.find_var_by_name("this.flags[]");
    if (i_vi != null && this_flags_array_vi != null) {
      dummyInv = dummyInvFactory.instantiate(ppt, new VarInfo[] {i_vi, this_flags_array_vi});
    }
  }

  public DummyInvariant getDummyInvariant() {
    return dummyInv;
  }

  public int[] getIntArray(long[] longArray) {
    int[] intArray = new int[longArray.length];
    for (int i = 0; i < intArray.length; i++) {
      intArray[i] = (int) longArray[i];
    }
    return intArray;
  }

}
