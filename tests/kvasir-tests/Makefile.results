# Targets for running a test suite and reporting its results.
# Included by tests/kvasir-tests/Makefile and tests/dyncomp-tests/Makefile.
#
# The including Makefile sets:
#   REGRESSION_TESTS_TARGET: the target that runs the tests and creates the .diff files
#   REGRESSION_TESTS_ARGS: extra arguments to make, when making REGRESSION_TESTS_TARGET
#   REGRESSION_SUMMARY_TARGET: the target that summarizes the tests

# args to 'find' program, to find files containing results
RESULTS_PATTERN :=    -name '*.diff'

.PHONY: regression-tests
# The .diff files are deleted first, so that a test that crashes does not
# leave behind a .diff file from an earlier run.
# -k keeps one failing test from preventing the others from running.
# The summary is skipped if a test failed, because it would re-run that test.
# The results are always printed.
regression-tests:
	@status=0; \
	find . ${RESULTS_PATTERN} -delete; \
	${MAKE} -k ${REGRESSION_TESTS_ARGS} ${REGRESSION_TESTS_TARGET} || status=$$?; \
	if [ $$status -eq 0 ]; then ${MAKE} ${REGRESSION_SUMMARY_TARGET} || status=$$?; fi; \
	${MAKE} --no-print-directory results TESTS_STATUS=$$status || status=$$?; \
	exit $$status

# Nonzero if building the tests failed, such as when a Kvasir run crashed.
# A crashed test produces no .diff files.
TESTS_STATUS ?= 0

# removes fields before the size (ie, permissions, owner, group).
PERL_CLEANUP_LS_OUTPUT = perl -ne 'BEGIN { $$failure=0; } /^\S+\s+\S+\s+\S+\s+\S+\s+(\d+)\s+(.*)\s+(\S+)$$/; if ($$1 > 0) { $$failure++; print "$$1\t$$2\t$$3\n";} END { if ($$failure == 1) { print "1 test failed.\n"; exit 1; } elsif ($$failure) { print "$$failure tests failed.\n"; exit 1; } elsif (${TESTS_STATUS}) { print "No diffs, but some tests failed to run; see the errors above.\n"; exit 1; } else { print "All tests succeeded.\n"; } }'

results_header:
	@echo ""
	@echo "=== RESULTS ==="

results_cat:
	@find . ${RESULTS_PATTERN} -print0 | xargs -0 cat

results: results_header results_cat summary_list

summary_list:
	@find . ${RESULTS_PATTERN} -exec ls -l {} + \
	  | perl -pe 's|\Q${BASE}|.|;' \
	  | ${PERL_CLEANUP_LS_OUTPUT}
