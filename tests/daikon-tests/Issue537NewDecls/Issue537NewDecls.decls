decl-version 2.0
var-comparability none

# A program point that is neither an entry nor an exit, as produced by convertcsv.pl.
ppt aprogram.point:::POINT
ppt-type point
variable cluster
  var-kind variable
  dec-type int
  rep-type int
  comparability 1
variable x
  var-kind variable
  dec-type int
  rep-type int
  comparability 1
